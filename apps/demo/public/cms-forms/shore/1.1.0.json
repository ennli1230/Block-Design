{
  "ref": {
    "id": "shore",
    "version": "1.1.0"
  },
  "label": "Liman turu talebi",
  "locale": "tr",
  "fields": [
    {
      "fieldId": "ship-name",
      "label": "Gemi adı",
      "type": "text",
      "validation": {
        "required": true,
        "maxLength": 160
      }
    },
    {
      "fieldId": "port",
      "label": "Varış limanı",
      "type": "select",
      "validation": {
        "required": true
      },
      "options": [
        {
          "value": "kusadasi",
          "label": "Kuşadası"
        },
        {
          "value": "izmir",
          "label": "İzmir"
        },
        {
          "value": "bodrum",
          "label": "Bodrum"
        }
      ]
    },
    {
      "fieldId": "arrival-date",
      "label": "Geliş tarihi",
      "type": "date",
      "validation": {
        "required": true
      }
    },
    {
      "fieldId": "guests",
      "label": "Kişi sayısı",
      "type": "number",
      "validation": {
        "required": true,
        "min": 1,
        "max": 20
      },
      "defaultValue": 2
    },
    {
      "fieldId": "email",
      "label": "E-posta adresiniz",
      "type": "email",
      "validation": {
        "required": true,
        "maxLength": 200
      }
    },
    {
      "fieldId": "notes",
      "label": "Tur beklentiniz (isteğe bağlı)",
      "type": "textarea",
      "validation": {
        "required": false,
        "maxLength": 2000
      },
      "layout": {
        "span": 2
      }
    }
  ],
  "layout": {
    "columns": 2
  },
  "action": {
    "adapterId": "demo-cms",
    "actionId": "shore",
    "kind": "submit",
    "label": "Liman turu talebi oluştur"
  }
}
